{
  "name": "drec-oncall-updates-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "triggers": {
    // Runs the GDELT + all-eight-state incident cache refreshes independently
    // of visitor traffic every 5 minutes, so a page load never waits on a
    // live fetch.
    //
    // Caching note: the cron tick fetches AND normalises each feed, then
    // stores the finished JSON in the Cloudflare Cache API under
    //   /gdelt, /incidents/<state> (x8), and /incidents-all
    // Visitor requests are therefore pure cache reads with no upstream call
    // and no JSON parsing -- which is what keeps per-request CPU inside the
    // free plan's budget. Entries carry a 2h max-age purely as an outer
    // bound in case the cron is ever disabled; freshness is the cron's job,
    // not a per-request check. A failed refresh deliberately leaves the
    // previous entry in place, so one flaky agency feed degrades to "slightly
    // stale" rather than "blank tab".
    //
    // No secrets are required by this Worker. The incident feeds are all
    // keyless public government sources (see the INCIDENT FEEDS section in
    // src/worker.js); the previous EMERGENCY_API_KEY binding for
    // emergencyapi.com has been retired along with that dependency, so there
    // is no longer any credential here to expire, rotate or leak.
    "crons": ["*/5 * * * *"]
  }

  // ---------------------------------------------------------------------
  // OPTIONAL, but recommended: a KV namespace for the news record.
  //
  // Without it the news article list is held in the Cloudflare Cache API,
  // which is PER DATACENTRE. The cron warms whichever location it runs in,
  // so a reader routed to a different one finds nothing cached and gets the
  // small cold-start feed until that location warms up too. With KV the
  // background refresh writes once and every location reads the same list
  // immediately -- so the dashboard opens with the full feed already there.
  //
  // To enable:
  //   1. Cloudflare dashboard -> Storage & Databases -> KV -> Create -> name
  //      it e.g. "newsradar" and copy its ID.
  //   2. Uncomment the block below and paste the ID.
  //   3. Redeploy.
  //
  // Cost on the free plan: the cron writes one record per 5-minute tick
  // (288/day against a 1,000/day limit) and each page load is one read
  // (against 100,000/day). The code falls back to the cache automatically if
  // the binding is absent, so this can be added at any time without a code
  // change.
  //
  // "kv_namespaces": [
  //   { "binding": "NEWS_KV", "id": "PASTE_YOUR_NAMESPACE_ID_HERE" }
  // ]
}
